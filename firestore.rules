rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /rooms/{roomId} {
      allow read: if member(roomId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if member(roomId);
      match /members/{uid} {
        allow read: if member(roomId);
        allow create: if signedIn() && request.auth.uid == uid && (
          !exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid)) ||
          member(roomId)
        );
        allow update: if signedIn() && request.auth.uid == uid;
      }
      match /meals/{mealId} {
        allow read: if member(roomId);
        allow create: if member(roomId) && request.resource.data.uid == request.auth.uid;
        allow delete: if member(roomId) && resource.data.uid == request.auth.uid;
        allow update: if member(roomId) && resource.data.uid == request.auth.uid;
      }
    }
  }
}